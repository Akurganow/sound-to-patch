{
  "name": "tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/tags/*"], "exclude": [] } },
  "bypass_actors": [
    { "actor_type": "DeployKey", "actor_id": null, "bypass_mode": "always" }
  ],
  "rules": [
    { "type": "creation" },
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "update" }
  ]
}
