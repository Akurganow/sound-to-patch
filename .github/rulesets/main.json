{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [
    { "actor_type": "DeployKey", "actor_id": null, "bypass_mode": "always" }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "fmt", "integration_id": 15368 },
          { "context": "clippy", "integration_id": 15368 },
          { "context": "test", "integration_id": 15368 },
          { "context": "doc", "integration_id": 15368 },
          { "context": "commits", "integration_id": 15368 },
          { "context": "licenses", "integration_id": 15368 },
          { "context": "docs", "integration_id": 15368 },
          { "context": "Analyze (rust)", "integration_id": 15368 }
        ]
      }
    }
  ]
}
