{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Akurganow/sound-to-patch/blob/main/schemas/layers.schema.json",
  "title": "layers.json",
  "description": "The analysis report of one stem, version layers/1. Field names are snake_case and carry their unit as a suffix (_hz, _s, _ms, _db, _dbfs, _deg, _st, _ct) where the value has one; a field without a suffix is a count, a ratio, a share, a power, a flag or a tempo. The conventions group names the convention of every number in the stem group and of every record in the layer groups.",
  "type": "object",
  "required": [
    "schema", "source", "synth", "stem", "transcription", "pitch", "envelope", "conventions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "layers/1" },
    "source": {
      "description": "The file name of the stem, without its folder. A later run into the same folder refuses a report of another source unless forced.",
      "type": "string",
      "minLength": 1
    },
    "synth": { "enum": ["vital", "serum2"] },
    "stem": { "$ref": "#/$defs/stem" },
    "transcription": { "$ref": "#/$defs/transcription" },
    "pitch": { "$ref": "#/$defs/pitch" },
    "envelope": { "$ref": "#/$defs/envelope" },
    "conventions": { "$ref": "#/$defs/conventions" }
  },
  "$defs": {
    "name": {
      "description": "A field name: snake_case ASCII.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "reason": {
      "type": "object",
      "required": ["code", "value"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/name" },
        "value": { "type": ["number", "boolean"] }
      }
    },
    "confidence": {
      "description": "An estimate has a level, at least one reason and an optional spread in the unit of its spread type. No estimate has at least one reason and neither a level nor a spread.",
      "oneOf": [
        {
          "type": "object",
          "required": ["level", "reasons", "estimate"],
          "additionalProperties": false,
          "properties": {
            "level": { "enum": ["low", "medium", "high"] },
            "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reason" } },
            "spread": { "type": "number" },
            "estimate": { "const": true }
          }
        },
        {
          "type": "object",
          "required": ["reasons", "estimate"],
          "additionalProperties": false,
          "properties": {
            "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reason" } },
            "estimate": { "const": false }
          }
        }
      ]
    },
    "no_estimate": {
      "properties": { "confidence": { "properties": { "estimate": { "const": false } } } }
    },
    "value": {
      "description": "One number and its confidence; the number is null exactly when there is no estimate.",
      "type": "object",
      "required": ["value", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "if": { "$ref": "#/$defs/no_estimate" },
      "then": { "properties": { "value": { "type": "null" } } },
      "else": { "properties": { "value": { "type": "number" } } }
    },
    "statistic": {
      "description": "The median and interquartile range over active frames; both are null exactly when there is no estimate.",
      "type": "object",
      "required": ["median", "iqr", "confidence"],
      "additionalProperties": false,
      "properties": {
        "median": { "type": ["number", "null"] },
        "iqr": { "type": ["number", "null"], "minimum": 0 },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "if": { "$ref": "#/$defs/no_estimate" },
      "then": { "properties": { "median": { "type": "null" }, "iqr": { "type": "null" } } },
      "else": { "properties": { "median": { "type": "number" }, "iqr": { "type": "number" } } }
    },
    "unit_statistic": {
      "allOf": [
        { "$ref": "#/$defs/statistic" },
        { "properties": { "median": { "minimum": 0 } } }
      ]
    },
    "band_share": {
      "type": "object",
      "required": ["value", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["lo_hz", "hi_hz", "share"],
            "additionalProperties": false,
            "properties": {
              "lo_hz": { "type": "number", "minimum": 0 },
              "hi_hz": { "type": "number", "minimum": 0 },
              "share": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "if": { "$ref": "#/$defs/no_estimate" },
      "then": { "properties": { "value": { "type": "null" } } },
      "else": { "properties": { "value": { "type": "array" } } }
    },
    "stereo_band": {
      "description": "A value is null when it does not exist: a one-channel file, a silent channel, a zero mid or side, or, for ipd_deg, no note list.",
      "type": "object",
      "required": ["rho", "sm_db", "ipd_deg"],
      "additionalProperties": false,
      "properties": {
        "rho": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "sm_db": { "type": ["number", "null"] },
        "ipd_deg": { "type": ["number", "null"] }
      }
    },
    "stereo": {
      "type": "object",
      "required": ["full", "sub", "low_mid", "high", "confidence"],
      "additionalProperties": false,
      "properties": {
        "full": { "$ref": "#/$defs/stereo_band" },
        "sub": { "$ref": "#/$defs/stereo_band" },
        "low_mid": { "$ref": "#/$defs/stereo_band" },
        "high": { "$ref": "#/$defs/stereo_band" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "stem": {
      "type": "object",
      "required": [
        "bpm", "bpm_given", "bpm_refined", "duration_s", "sample_rate_hz", "band_edge_hz",
        "hard_limited", "peak_dbfs", "rms_dbfs", "crest_db", "centroid_hz", "centroid_over_f0",
        "spread_hz", "rolloff85_hz", "rolloff95_hz", "flatness", "band_share", "stereo"
      ],
      "additionalProperties": false,
      "properties": {
        "bpm": { "type": "number", "minimum": 4, "maximum": 1000 },
        "bpm_given": { "type": "number", "minimum": 4, "maximum": 1000 },
        "bpm_refined": { "$ref": "#/$defs/value" },
        "duration_s": { "type": "number", "minimum": 0 },
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "band_edge_hz": { "$ref": "#/$defs/value" },
        "hard_limited": { "type": "boolean" },
        "peak_dbfs": { "$ref": "#/$defs/value" },
        "rms_dbfs": { "$ref": "#/$defs/value" },
        "crest_db": { "$ref": "#/$defs/value" },
        "centroid_hz": { "$ref": "#/$defs/unit_statistic" },
        "centroid_over_f0": {
          "description": "Null without a note list.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/unit_statistic" }]
        },
        "spread_hz": { "$ref": "#/$defs/unit_statistic" },
        "rolloff85_hz": { "$ref": "#/$defs/unit_statistic" },
        "rolloff95_hz": { "$ref": "#/$defs/unit_statistic" },
        "flatness": {
          "allOf": [
            { "$ref": "#/$defs/statistic" },
            { "properties": { "median": { "minimum": 0, "maximum": 1 } } }
          ]
        },
        "band_share": { "$ref": "#/$defs/band_share" },
        "stereo": { "$ref": "#/$defs/stereo" }
      }
    },
    "transcription": {
      "description": "The transcriber's model and settings, or null when no transcriber ran, as with a given note list.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["model_sha256", "crate_version", "profile", "note_params"],
          "additionalProperties": false,
          "properties": {
            "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "crate_version": { "type": "string" },
            "profile": { "enum": ["bass", "lead", "pad", "detected"] },
            "note_params": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/name" },
              "additionalProperties": { "type": ["number", "boolean"] }
            }
          }
        }
      ]
    },
    "conventions": {
      "type": "object",
      "required": [
        "frame_size", "statistics", "spectral", "bpm", "bpm_given", "bpm_refined", "duration_s",
        "sample_rate_hz", "band_edge_hz", "hard_limited", "peak_dbfs", "rms_dbfs", "crest_db",
        "centroid_hz", "centroid_over_f0", "spread_hz", "rolloff85_hz", "rolloff95_hz",
        "flatness", "band_share", "stereo", "confidence", "pitch", "glides", "drops",
        "sub_band_line", "vibrato", "envelope", "note_off", "level_spread_db", "pump"
      ],
      "propertyNames": { "$ref": "#/$defs/name" },
      "properties": {
        "frame_size": { "enum": [4096, 8192] }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "layer_group": {
      "description": "The shape of every layer group at the top level. values is null when the evidence is too thin, and the confidence then says why. suggested_edits is a list of records in the edit-list format, each a param or a route with unit strings, so a route keeps its source, amount and polarity; the mapping step fills it, and until then it is empty.",
      "type": "object",
      "required": ["values", "confidence", "flags", "needs_render", "suggested_edits"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": ["object", "null"],
          "propertyNames": { "$ref": "#/$defs/name" }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "flags": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "boolean" }
        },
        "needs_render": { "type": "boolean" },
        "suggested_edits": {
          "type": "array",
          "items": {
            "description": "One record of the edit-list format.",
            "type": "object",
            "minProperties": 1
          }
        }
      },
      "if": { "$ref": "#/$defs/no_estimate" },
      "then": { "properties": { "values": { "type": "null" } } }
    },
    "envelope": {
      "description": "The envelope layer: the amplitude envelope over the pooled notes, the peak level, attack and note-off knee of each read note, and the sidechain pump. values is null when no note was read.",
      "allOf": [
        { "$ref": "#/$defs/layer_group" },
        {
          "properties": {
            "values": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "attack_s", "hold_s", "decay_s", "sustain_db", "note_off_offset_s",
                    "level_spread_db", "ripple_db", "fit_residual_db", "n_notes_used",
                    "overlap_fraction",
                    "pump_depth_db", "pump_recovery_s", "pump_tau_ms", "pump_locked_to",
                    "pump_beats", "pump_bpm", "notes"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "attack_s": { "$ref": "#/$defs/unit_statistic" },
                    "hold_s": { "$ref": "#/$defs/unit_statistic" },
                    "decay_s": { "$ref": "#/$defs/unit_statistic" },
                    "sustain_db": { "$ref": "#/$defs/statistic" },
                    "note_off_offset_s": { "$ref": "#/$defs/statistic" },
                    "level_spread_db": { "$ref": "#/$defs/value" },
                    "ripple_db": { "type": ["number", "null"], "minimum": 0 },
                    "fit_residual_db": { "type": ["number", "null"], "minimum": 0 },
                    "n_notes_used": { "type": "integer", "minimum": 0 },
                    "overlap_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "pump_depth_db": { "type": ["number", "null"], "minimum": 0 },
                    "pump_recovery_s": { "type": ["number", "null"], "minimum": 0 },
                    "pump_tau_ms": { "type": ["number", "null"], "minimum": 0 },
                    "pump_locked_to": { "enum": ["beat", "note", "free", "none", null] },
                    "pump_beats": { "type": "integer", "minimum": 0 },
                    "pump_bpm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
                    "notes": { "type": "array", "items": { "$ref": "#/$defs/note_envelope" } }
                  }
                }
              ]
            },
            "flags": {
              "required": ["no_notes", "attack_is_upper_bound", "pump_stripped"],
              "additionalProperties": false,
              "properties": {
                "no_notes": { "type": "boolean" },
                "attack_is_upper_bound": { "type": "boolean" },
                "pump_stripped": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "note_envelope": {
      "description": "One read note: its onset, the peak of its amp proxy, its attack, its note-off knee, and whether the pool holds it.",
      "type": "object",
      "required": ["onset_s", "peak_db", "attack_s", "attack_upper_bound", "knee_s", "pooled"],
      "additionalProperties": false,
      "properties": {
        "onset_s": { "type": "number", "minimum": 0 },
        "peak_db": { "type": "number" },
        "attack_s": { "type": ["number", "null"], "minimum": 0 },
        "attack_upper_bound": { "type": "boolean" },
        "knee_s": { "type": ["number", "null"], "minimum": 0 },
        "pooled": { "type": "boolean" }
      }
    },
    "pitch": {
      "description": "The pitch layer of a monophonic line: glides, pitch drops and vibrato, each record with its own confidence. values is null when the line plays chords or has no notes; a line without a glide holds an empty list.",
      "allOf": [
        { "$ref": "#/$defs/layer_group" },
        {
          "properties": {
            "values": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["glides", "drops", "vibrato"],
                  "additionalProperties": false,
                  "properties": {
                    "glides": { "type": "array", "items": { "$ref": "#/$defs/glide" } },
                    "drops": { "type": "array", "items": { "$ref": "#/$defs/drop" } },
                    "vibrato": { "type": "array", "items": { "$ref": "#/$defs/vibrato" } }
                  }
                }
              ]
            },
            "flags": {
              "required": ["chord_skipped", "glide_too_short", "weak_fundamental", "no_notes"],
              "additionalProperties": false,
              "properties": {
                "chord_skipped": { "type": "boolean" },
                "glide_too_short": { "type": "boolean" },
                "weak_fundamental": { "type": "boolean" },
                "no_notes": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "estimate": {
      "description": "The confidence of a record, which always holds an estimate.",
      "allOf": [
        { "$ref": "#/$defs/confidence" },
        { "properties": { "estimate": { "const": true } } }
      ]
    },
    "glide": {
      "type": "object",
      "required": ["start_s", "interval_st", "time_s", "curve", "from_silence", "confidence"],
      "additionalProperties": false,
      "properties": {
        "start_s": { "type": "number", "minimum": 0 },
        "interval_st": { "type": "number" },
        "time_s": { "type": "number", "minimum": 0.09 },
        "curve": { "type": "number", "exclusiveMinimum": 0.21, "maximum": 5 },
        "from_silence": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/estimate" }
      }
    },
    "drop": {
      "type": "object",
      "required": ["onset_s", "f_end_hz", "df_st", "df_hz", "tau_s", "residual", "confidence"],
      "additionalProperties": false,
      "properties": {
        "onset_s": { "type": "number", "minimum": 0 },
        "f_end_hz": { "type": "number", "exclusiveMinimum": 0 },
        "df_st": { "type": "number", "exclusiveMinimum": 2, "maximum": 36 },
        "df_hz": { "type": "number", "exclusiveMinimum": 0 },
        "tau_s": { "type": "number", "exclusiveMinimum": 0.003 },
        "residual": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.15 },
        "confidence": { "$ref": "#/$defs/estimate" }
      }
    },
    "vibrato": {
      "type": "object",
      "required": [
        "start_s", "end_s", "rate_hz", "extent_ct", "extent_raw_ct", "extent_factor", "share",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "start_s": { "type": "number", "minimum": 0 },
        "end_s": { "type": "number", "minimum": 0 },
        "rate_hz": { "type": "number", "minimum": 2.97, "maximum": 12.12 },
        "extent_ct": { "type": "number", "minimum": 10 },
        "extent_raw_ct": { "type": "number", "minimum": 0 },
        "extent_factor": { "type": "number", "exclusiveMinimum": 0 },
        "share": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "confidence": { "$ref": "#/$defs/estimate" }
      }
    }
  }
}
