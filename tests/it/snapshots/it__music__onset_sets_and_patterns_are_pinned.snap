---
source: tests/it/music.rs
expression: "pins(dictionary.entries.iter().filter_map(|entry|\n{\n    match &entry.rule\n    {\n        Rule::OnsetSet { parts } =>\n        {\n            let parts: Vec<String> =\n            parts.iter().map(|part|\n            format!(\"{} {:?}\", part.part, part.slots)).collect();\n            Some(format!(\"{} {}\", entry.id, parts.join(\"; \")))\n        } Rule::Pattern { k, n, rotation } =>\n        Some(format!(\"{} E({k},{n}) r{rotation}\", entry.id)), _ => None,\n    }\n}))"
---
